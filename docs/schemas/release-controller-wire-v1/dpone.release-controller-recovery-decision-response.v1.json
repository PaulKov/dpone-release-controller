{
  "$id": "https://paulkov.github.io/dpone-release-controller/schemas/wire/dpone.release-controller-recovery-decision-response.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "append_count": {
      "const": 2
    },
    "appended_selectors": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "attempt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "batch_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "classification": {
      "enum": [
        "CLOSE_EXACT",
        "INCIDENT_HOLD",
        "RESUME_ORIGINAL_CANDIDATE"
      ]
    },
    "fencing_token": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "first_receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "first_receipt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "first_sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "head_receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_receipt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release_identity_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "resulting_state": {
      "enum": [
        "GITHUB_IMMUTABLE",
        "INCIDENT_HOLD",
        "LEASED",
        "PYPI_RECOVERY",
        "PYPI_VERIFIED"
      ]
    },
    "resume_phase": {
      "enum": [
        null,
        "GITHUB_IMMUTABLE",
        "LEASED_RESTART",
        "PYPI_RECOVERY",
        "PYPI_VERIFIED"
      ]
    },
    "schema": {
      "const": "dpone.release-controller-recovery-decision-response.v1"
    },
    "schema_version": {
      "const": 1
    },
    "tag": {
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "workflow_outcome": {
      "enum": [
        "CONTINUE",
        "HOLD"
      ]
    }
  },
  "required": [
    "schema",
    "schema_version",
    "head_receipt_id",
    "head_receipt_sha256",
    "head_sequence",
    "release_identity_id",
    "tag",
    "append_count",
    "appended_selectors",
    "attempt_id",
    "batch_sha256",
    "classification",
    "fencing_token",
    "first_receipt_id",
    "first_receipt_sha256",
    "first_sequence",
    "lease_id",
    "resulting_state",
    "resume_phase",
    "workflow_outcome"
  ],
  "type": "object"
}
