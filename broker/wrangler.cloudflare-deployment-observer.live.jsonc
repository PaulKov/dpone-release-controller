    "EXPECTED_INGRESS_SERVICE_IDENTITY": "INJECTED_BY_AUTHORITY_VERSION_CEREMONY",
    "OPERATING_MODE": "live",
    "SERVICE_NAME": "dpone-release-cloudflare-deployment-observer",
  },
  "services": [
    {
      "binding": "WORM_MIRROR",
      "service": "dpone-release-worm-mirror",
    },
  ],
  "version_metadata": {
