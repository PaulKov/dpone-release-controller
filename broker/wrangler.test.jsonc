{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dpone-release-authority-broker-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "OPERATING_MODE": "provisioning",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVATION_REGISTRY",
        "class_name": "ActivationRegistry",
      },
      {
        "name": "AUTH_REPLAY_LEDGER",
        "class_name": "AuthReplayLedger",
      },
      {
        "name": "GLOBAL_ACTIVATED_AUTHORITY_HEAD",
        "class_name": "GlobalActivatedAuthorityHead",
      },
      {
        "name": "RELEASE_LEDGERS",
        "class_name": "ReleaseLedger",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AuthReplayLedger", "ReleaseLedger"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ActivationRegistry"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["GlobalActivatedAuthorityHead"],
    },
  ],
}
