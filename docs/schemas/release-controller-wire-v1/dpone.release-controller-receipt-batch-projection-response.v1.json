{
  "$id": "https://paulkov.github.io/dpone-release-controller/schemas/wire/dpone.release-controller-receipt-batch-projection-response.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_selectors": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z][A-Z0-9_]*)?$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "batch_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "first_receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_receipt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_sequence": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "operation_id": {
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "type": "string"
    },
    "receipt_count": {
      "maximum": 64,
      "minimum": 1,
      "type": "integer"
    },
    "release_identity_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "dpone.release-controller-receipt-batch-projection-response.v1"
    },
    "schema_version": {
      "const": 1
    },
    "tag": {
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "authority_selectors",
    "batch_sha256",
    "first_receipt_id",
    "head_receipt_id",
    "head_receipt_sha256",
    "head_sequence",
    "operation_id",
    "receipt_count",
    "release_identity_id",
    "tag"
  ],
  "type": "object"
}
