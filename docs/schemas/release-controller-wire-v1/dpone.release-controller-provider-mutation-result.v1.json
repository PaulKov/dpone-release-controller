{
  "$id": "https://paulkov.github.io/dpone-release-controller/schemas/wire/dpone.release-controller-provider-mutation-result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "operation": {
      "enum": [
        "ATTESTATION_CREATE",
        "GITHUB_RELEASE_PUBLISH"
      ]
    },
    "provider_request_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release_identity_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "dpone.release-controller-provider-mutation-result.v1"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "MUTATION_SUBMITTED_UNVERIFIED"
    },
    "tag": {
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "operation",
    "provider_request_sha256",
    "release_identity_id",
    "status",
    "tag"
  ],
  "type": "object"
}
