{
  "$id": "https://paulkov.github.io/dpone-release-controller/schemas/wire/dpone.release-controller-lease-renew-response.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "durable_state": {
      "enum": [
        "ABORTED",
        "INCIDENT_HOLD",
        "LEASED_ACTIVE",
        "RECOVERY_REQUIRED",
        "TERMINAL"
      ]
    },
    "fencing_token": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "head_receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_receipt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "lease_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release_identity_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "renewal": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expires_at": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
              "type": "string"
            },
            "receipt_id": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "receipt_sha256": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "sequence": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "expires_at",
            "receipt_id",
            "receipt_sha256",
            "sequence"
          ],
          "type": "object"
        }
      ]
    },
    "schema": {
      "const": "dpone.release-controller-lease-renew-response.v1"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ABORTED",
        "ACTIVE",
        "EXPIRED",
        "HOLD",
        "RELEASED"
      ]
    },
    "tag": {
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "head_receipt_id",
    "head_receipt_sha256",
    "head_sequence",
    "release_identity_id",
    "tag",
    "durable_state",
    "fencing_token",
    "lease_id",
    "renewal",
    "status"
  ],
  "type": "object"
}
