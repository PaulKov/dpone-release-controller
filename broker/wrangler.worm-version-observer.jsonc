{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dpone-release-worm-version-observer-provisioning",
  "main": "src/private/worm-version-observer-worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 0,
    "traces": {
      "destinations": [],
      "enabled": false,
      "head_sampling_rate": 0,
      "persist": false,
    },
  },
  "vars": {
    "OPERATING_MODE": "provisioning",
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
}
