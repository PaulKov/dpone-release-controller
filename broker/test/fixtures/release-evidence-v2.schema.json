{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "protected_base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "read_count": {
          "const": 2
        },
        "snapshot_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "read_count",
        "snapshot_sha256",
        "protected_base_sha"
      ],
      "type": "object"
    }
  },
  "$id": "https://paulkov.github.io/dpone-release-controller/schemas/release/release-evidence-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/digest"
    },
    "authorization": {
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "$ref": "#/$defs/digest"
        },
        "authorization_state": {
          "const": "AUTHORIZED"
        },
        "fencing_token": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "lease_id": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "authorization_id",
        "authorization_state",
        "lease_id",
        "fencing_token"
      ],
      "type": "object"
    },
    "candidate_id": {
      "$ref": "#/$defs/digest"
    },
    "decision": {
      "const": "GO"
    },
    "governance_snapshots": {
      "additionalProperties": false,
      "properties": {
        "A": {
          "$ref": "#/$defs/snapshot"
        },
        "B": {
          "$ref": "#/$defs/snapshot"
        },
        "C": {
          "$ref": "#/$defs/snapshot"
        }
      },
      "required": [
        "A",
        "B",
        "C"
      ],
      "type": "object"
    },
    "release_authority_id": {
      "$ref": "#/$defs/digest"
    },
    "release_identity_id": {
      "$ref": "#/$defs/digest"
    },
    "schema": {
      "const": "dpone.release-evidence.v2"
    },
    "schema_version": {
      "const": 2
    },
    "state": {
      "const": "CLOSED"
    },
    "status": {
      "const": "PASS"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "status",
    "decision",
    "state",
    "release_identity_id",
    "release_authority_id",
    "candidate_id",
    "attempt_id",
    "authorization",
    "governance_snapshots"
  ],
  "title": "dpone release evidence v2",
  "type": "object"
}
