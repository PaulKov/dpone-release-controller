{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dpone.dev/schemas/release/github-ruleset-projection-v1.schema.json",
  "title": "dpone GitHub branch-ruleset projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "repository",
    "repository_id",
    "id",
    "name",
    "target",
    "source_type",
    "source",
    "enforcement",
    "conditions",
    "bypass_actors",
    "rules"
  ],
  "properties": {
    "schema": {"const": "dpone.github-ruleset-projection.v1"},
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "repository_id": {"type": "integer", "minimum": 1},
    "id": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "target": {"const": "branch"},
    "source_type": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "enforcement": {"type": "string", "minLength": 1},
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclude", "include"],
      "properties": {
        "exclude": {"$ref": "#/$defs/stringSet"},
        "include": {"$ref": "#/$defs/stringSet"}
      }
    },
    "bypass_actors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "actor_type", "bypass_mode"],
        "properties": {
          "actor_id": {"type": ["integer", "null"], "minimum": 1},
          "actor_type": {"type": "string", "minLength": 1},
          "bypass_mode": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/deletion"},
        {"$ref": "#/$defs/nonFastForward"},
        {"$ref": "#/$defs/pullRequest"},
        {"$ref": "#/$defs/statusChecks"}
      ]
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "deletion"}}
    },
    "nonFastForward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "non_fast_forward"}}
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "type"],
      "properties": {
        "type": {"const": "pull_request"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_merge_methods",
            "dismiss_stale_reviews_on_push",
            "require_code_owner_review",
            "require_last_push_approval",
            "required_approving_review_count",
            "required_review_thread_resolution",
            "required_reviewers"
          ],
          "properties": {
            "allowed_merge_methods": {"$ref": "#/$defs/stringSet"},
            "dismiss_stale_reviews_on_push": {"type": "boolean"},
            "require_code_owner_review": {"type": "boolean"},
            "require_last_push_approval": {"type": "boolean"},
            "required_approving_review_count": {"type": "integer", "minimum": 0, "maximum": 10},
            "required_review_thread_resolution": {"type": "boolean"},
            "required_reviewers": {"type": "array", "maxItems": 0}
          }
        }
      }
    },
    "statusCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "integration_id"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "integration_id": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "statusChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "type"],
      "properties": {
        "type": {"const": "required_status_checks"},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "do_not_enforce_on_create",
            "required_status_checks",
            "strict_required_status_checks_policy"
          ],
          "properties": {
            "do_not_enforce_on_create": {"const": false},
            "required_status_checks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/statusCheck"}
            },
            "strict_required_status_checks_policy": {"type": "boolean"}
          }
        }
      }
    }
  }
}
