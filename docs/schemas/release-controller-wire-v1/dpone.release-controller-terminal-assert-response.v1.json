{
  "$id": "https://paulkov.github.io/dpone-release-controller/schemas/wire/dpone.release-controller-terminal-assert-response.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_outcome": {
      "enum": [
        "FAIL",
        "SUCCESS"
      ]
    },
    "durable_state": {
      "enum": [
        "ABORTED",
        "ACTIVE",
        "INCIDENT_HOLD",
        "RECOVERY_REQUIRED",
        "TERMINAL"
      ]
    },
    "head_receipt_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_receipt_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "head_sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "release_identity_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "dpone.release-controller-terminal-assert-response.v1"
    },
    "schema_version": {
      "const": 1
    },
    "sentinel_status": {
      "enum": [
        "ABORTED",
        "ACTIVE",
        "EXPIRED",
        "HOLD",
        "RELEASED"
      ]
    },
    "tag": {
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "head_receipt_id",
    "head_receipt_sha256",
    "head_sequence",
    "release_identity_id",
    "tag",
    "action_outcome",
    "durable_state",
    "sentinel_status"
  ],
  "type": "object"
}
